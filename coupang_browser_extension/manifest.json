{
  "manifest_version": 3,
  "name": "TinySnow Coupang Existing Browser Bridge",
  "version": "1.8.0",
  "minimum_chrome_version": "118",
  "description": "直接在目前已登入的 Chrome/Edge 中智能選擇 WING 營運資料頁、全量翻頁商品並支援定時監控。",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "debugger",
    "downloads",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://wing.coupang.com/*",
    "https://*.coupang.com/*",
    "https://*.coupangcdn.com/*"
  ],
  "background": {
    "service_worker": "background_v18_entry.js"
  },
  "action": {
    "default_title": "TinySnow Coupang",
    "default_popup": "popup_v18.html"
  }
}
