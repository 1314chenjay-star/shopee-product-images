{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tinysnow.agent-command.1",
  "title": "TinySnow Agent Command",
  "type": "object",
  "required": [
    "command_id",
    "created_at",
    "priority",
    "action",
    "scope",
    "reason",
    "allowed_operations",
    "forbidden_operations",
    "required_validation",
    "status"
  ],
  "properties": {
    "command_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "priority": {"type": "integer", "minimum": 1},
    "action": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "allowed_operations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "forbidden_operations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_validation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED", "BLOCKED_OWNER_DECISION", "BLOCKED_STATE_ANALYSIS"]},
    "owner_approval": {"type": "boolean", "default": false},
    "retry_count": {"type": "integer", "minimum": 0, "default": 0},
    "checkpoint": {"type": "string"}
  },
  "additionalProperties": true
}
